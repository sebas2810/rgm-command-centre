{
  "name": "rgm-command-centre",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/api",
    "packages/frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/frontend",
    "dev:api": "npm run dev --workspace=packages/api",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev\"",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=packages/api && npm run build --workspace=packages/frontend",
    "build:frontend": "npm run build --workspace=packages/frontend",
    "build:api": "npm run build --workspace=packages/api",
    "db:migrate": "npm run db:migrate --workspace=packages/api",
    "db:seed": "npm run db:seed --workspace=packages/api"
  }
}
